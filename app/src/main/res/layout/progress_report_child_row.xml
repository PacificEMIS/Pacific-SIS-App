<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/llwhitedesign"
    android:backgroundTint="@color/white"
    android:orientation="vertical"

    android:layout_marginBottom="20dp">
    <LinearLayout
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.pacific.others.customtext.Custom_Text_View_Bold
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Assignment Type :"
                android:layout_weight="0.5"></com.pacific.others.customtext.Custom_Text_View_Bold>
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_marginLeft="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/black"
                android:id="@+id/tvAssignmentType"
                android:layout_weight="1"></com.pacific.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.pacific.others.customtext.Custom_Text_View_Bold
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Weight(%) :"
                android:layout_weight="0.5"></com.pacific.others.customtext.Custom_Text_View_Bold>
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_marginLeft="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/black"
                android:id="@+id/tvWeight"
                android:layout_weight="1"></com.pacific.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.pacific.others.customtext.Custom_Text_View_Bold
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Assignment :"
                android:layout_weight="0.5"></com.pacific.others.customtext.Custom_Text_View_Bold>
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_marginLeft="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/black"
                android:id="@+id/tvAssignment"
                android:layout_weight="1"></com.pacific.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.pacific.others.customtext.Custom_Text_View_Bold
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Assignment Date:"
                android:layout_weight="0.5"></com.pacific.others.customtext.Custom_Text_View_Bold>
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_marginLeft="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/black"
                android:id="@+id/tvAssignmentDate"
                android:layout_weight="1"></com.pacific.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.pacific.others.customtext.Custom_Text_View_Bold
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Due Date:"
                android:layout_weight="0.5"></com.pacific.others.customtext.Custom_Text_View_Bold>
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_marginLeft="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/black"
                android:id="@+id/tvDueDate"
                android:layout_weight="1"></com.pacific.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.pacific.others.customtext.Custom_Text_View_Bold
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Points:"
                android:layout_weight="0.5"></com.pacific.others.customtext.Custom_Text_View_Bold>
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_marginLeft="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/black"
                android:id="@+id/tvPoints"
                android:layout_weight="1"></com.pacific.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.pacific.others.customtext.Custom_Text_View_Bold
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Grade:"
                android:layout_weight="0.5"></com.pacific.others.customtext.Custom_Text_View_Bold>
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_marginLeft="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/black"
                android:id="@+id/tvGrade"
                android:layout_weight="1"></com.pacific.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.pacific.others.customtext.Custom_Text_View_Bold
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Weight Grade:"
                android:layout_weight="0.5"></com.pacific.others.customtext.Custom_Text_View_Bold>
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_marginLeft="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/black"
                android:id="@+id/tvWeightGrade"
                android:layout_weight="1"></com.pacific.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.pacific.others.customtext.Custom_Text_View_Bold
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Comment:"
                android:layout_weight="0.5"></com.pacific.others.customtext.Custom_Text_View_Bold>
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_marginLeft="5dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/black"
                android:id="@+id/tvComment"
                android:layout_weight="1"></com.pacific.others.customtext.Custom_Text_View>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bar"></View>
</LinearLayout>