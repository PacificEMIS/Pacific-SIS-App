<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
   >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@drawable/twosidecurveheader"
                        android:padding="24dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                                android:text="Report Card"
                                android:layout_marginLeft="20dp"
                                android:layout_gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/big_text"
                                android:layout_weight="0.5"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>



                        </LinearLayout>






                    </LinearLayout>
                    <FrameLayout
                        android:layout_marginTop="110dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:visibility="visible"
                            android:id="@+id/llList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="20dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:orientation="vertical"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white">
                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/medium_text"
                                    android:textColor="@color/bar"
                                    android:text="School Year"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="@drawable/llgreystrokedesign"
                                    android:layout_marginTop="10dp">
                                    <Spinner
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:id="@+id/spSchoolYear"></Spinner>
                                </LinearLayout>
                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                    android:layout_marginTop="20dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/medium_text"
                                    android:textColor="@color/bar"
                                    android:text="Marking Period"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:background="@drawable/llgreystrokedesign"
                                    android:layout_marginTop="10dp">
                                    <Spinner
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:id="@+id/spMarkingPeriod"></Spinner>
                                </LinearLayout>
                                <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:padding="10dp"
                                    android:background="@drawable/llwhitedesign"
                                    android:backgroundTint="@color/text_color"
                                    android:layout_marginTop="20dp"
                                    android:textSize="@dimen/medium_text"
                                    android:textColor="@color/white"
                                    android:text="View Report Card"
                                    android:id="@+id/tvReportCard"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
                            </LinearLayout>






                        </LinearLayout>

                    </FrameLayout>




                </FrameLayout>
            </LinearLayout>




        </LinearLayout>
    </LinearLayout>

</layout>