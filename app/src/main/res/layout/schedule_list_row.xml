<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/llwhitedesign"
    android:backgroundTint="@color/white"
    android:padding="10dp"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">
    <com.pacific.others.customtext.Custom_Text_View_Bold
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/large_text"
        android:textColor="@color/black"
        android:id="@+id/tvCOurseSectionName"
        android:text="French"></com.pacific.others.customtext.Custom_Text_View_Bold>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/black"
            android:background="@drawable/llwhitedesign"
            android:gravity="center"
            android:padding="10dp">
            <com.pacific.others.customtext.Custom_Text_View
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/medium_text"
                android:textColor="@color/white"
                android:id="@+id/tvCourseTitle"
                android:text="English"
                android:textAlignment="center"></com.pacific.others.customtext.Custom_Text_View>

        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center|end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/lnWeekDays"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/lnSun"
                    android:gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/llgreystrokedesign">
                    <com.pacific.others.customtext.Custom_Text_View_Bold
                        android:id="@+id/tvSun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_text"
                        android:textColor="@color/bar"
                        android:text="U"></com.pacific.others.customtext.Custom_Text_View_Bold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginLeft="2dp"
                    android:id="@+id/lnMon"
                    android:gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/llgreystrokedesign">
                    <com.pacific.others.customtext.Custom_Text_View_Bold
                        android:id="@+id/tvMon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_text"
                        android:textColor="@color/bar"
                        android:text="M"></com.pacific.others.customtext.Custom_Text_View_Bold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginLeft="2dp"
                    android:id="@+id/lnTus"
                    android:gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/llgreystrokedesign">
                    <com.pacific.others.customtext.Custom_Text_View_Bold
                        android:id="@+id/tvTus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_text"
                        android:textColor="@color/bar"
                        android:text="T"></com.pacific.others.customtext.Custom_Text_View_Bold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginLeft="2dp"
                    android:id="@+id/lnWed"
                    android:gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/llgreystrokedesign">
                    <com.pacific.others.customtext.Custom_Text_View_Bold
                        android:id="@+id/tvWed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_text"
                        android:textColor="@color/black"
                        android:text="W"></com.pacific.others.customtext.Custom_Text_View_Bold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginLeft="2dp"
                    android:id="@+id/lnThu"
                    android:gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/llgreystrokedesign">
                    <com.pacific.others.customtext.Custom_Text_View_Bold
                        android:id="@+id/tvThu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_text"
                        android:textColor="@color/bar"
                        android:text="R"></com.pacific.others.customtext.Custom_Text_View_Bold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginLeft="2dp"
                    android:id="@+id/lnFri"
                    android:gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/llgreystrokedesign">
                    <com.pacific.others.customtext.Custom_Text_View_Bold
                        android:id="@+id/tvFri"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_text"
                        android:textColor="@color/black"
                        android:text="F"></com.pacific.others.customtext.Custom_Text_View_Bold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginLeft="2dp"
                    android:id="@+id/lnSat"
                    android:gravity="center"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/llgreystrokedesign">
                    <com.pacific.others.customtext.Custom_Text_View_Bold
                        android:id="@+id/tvSat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_text"
                        android:textColor="@color/bar"
                        android:text="S"></com.pacific.others.customtext.Custom_Text_View_Bold>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lnCalenDarDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right">
                <com.pacific.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvDays"></com.pacific.others.customtext.Custom_Text_View>
            </LinearLayout>
        </FrameLayout>


    </LinearLayout>

</LinearLayout>