<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/nurse"
          ></ImageView>
        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/medium_text"
            android:layout_gravity="center"
            android:layout_marginLeft="10dp"
            android:id="@+id/tvVisitReason"
            android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="30dp">
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/small_text"
            android:layout_marginLeft="10dp"
            android:id="@+id/tvVisitDate"
            android:textColor="@color/bar"></com.opensissasstudent.others.customtext.Custom_Text_View>
    </LinearLayout>
    <LinearLayout

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="40dp"
        android:orientation="vertical">
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/small_text"
            android:text="Result"
            android:textColor="@color/bar"
            ></com.opensissasstudent.others.customtext.Custom_Text_View>
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/medium_text"
            android:layout_marginTop="5dp"
            android:id="@+id/tvResult"
            android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View>
    </LinearLayout>
    <LinearLayout

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="40dp"
        android:orientation="vertical">
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/small_text"
            android:text="Comment"
            android:textColor="@color/bar"></com.opensissasstudent.others.customtext.Custom_Text_View>
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/medium_text"
            android:layout_marginTop="5dp"
            android:id="@+id/tvComment"
            android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View>
    </LinearLayout>

</LinearLayout>