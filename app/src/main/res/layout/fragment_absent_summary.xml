<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@drawable/twosidecurveheader"
                        android:padding="24dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                                android:text="Absence Summary"
                                android:layout_marginLeft="20dp"
                                android:layout_gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/big_text"
                                android:layout_weight="0.5"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>



                        </LinearLayout>






                    </LinearLayout>
                    <FrameLayout
                        android:layout_marginTop="110dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp">
                        <LinearLayout
                            android:visibility="visible"
                            android:id="@+id/llList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="20dp"
                            android:orientation="vertical"
                            android:background="@drawable/llwhitedesign"
                            android:backgroundTint="@color/white">
                            <LinearLayout
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:background="@drawable/llgreystrokedesign"
                                android:orientation="vertical">
                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/medium_text"
                                    android:textColor="@color/bar"
                                    android:text="Show Report by"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                <Spinner
                                    android:background="@drawable/llgreystrokedesign"
                                    android:id="@+id/spQTR"
                                    android:layout_marginTop="5dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"></Spinner>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_marginTop="20dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:background="@drawable/llgreystrokedesign"
                                android:orientation="vertical">
                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/medium_text"
                                    android:textColor="@color/bar"
                                    android:text="Period"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                <Spinner
                                    android:id="@+id/spPeriod"
                                    android:layout_marginTop="5dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"></Spinner>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_marginTop="20dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:background="@drawable/llgreystrokedesign"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_weight="1"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent">
                                    <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/medium_text"
                                        android:textColor="@color/bar"
                                        android:text="From Date"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                    <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                        android:layout_marginTop="5dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/medium_text"
                                        android:textColor="@color/black"
                                        android:id="@+id/tvFromDate"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/llFromDate"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="0.3"
                                    android:gravity="center">
                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/calendar_black_48dp"></ImageView>
                                </LinearLayout>


                            </LinearLayout>
                            <LinearLayout
                                android:layout_marginTop="20dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:background="@drawable/llgreystrokedesign"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_weight="1"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent">
                                    <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/medium_text"
                                        android:textColor="@color/bar"
                                        android:text="To Date"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                    <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                        android:layout_marginTop="5dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/medium_text"
                                        android:textColor="@color/black"
                                        android:id="@+id/tvToDate"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                </LinearLayout>
                                <LinearLayout
                                    android:id="@+id/llToDate"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="0.3"
                                    android:gravity="center">
                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/calendar_black_48dp"></ImageView>
                                </LinearLayout>


                            </LinearLayout>
                            <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="20dp"
                                android:gravity="center"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/text_color"
                                android:textColor="@color/white"
                                android:text="Search"
                                android:id="@+id/tvSearch"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>






                        </LinearLayout>

                    </FrameLayout>




                </FrameLayout>
            </LinearLayout>




        </LinearLayout>
    </LinearLayout>

</layout>