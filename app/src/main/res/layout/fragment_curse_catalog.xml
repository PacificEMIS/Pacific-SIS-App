<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

 <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/background_color">
     <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:orientation="vertical">

         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="match_parent">

             <FrameLayout
                 android:layout_width="match_parent"
                 android:layout_height="match_parent"
                 >

                 <LinearLayout
                     android:orientation="vertical"
                     android:layout_width="match_parent"
                     android:layout_height="160dp"
                     android:background="@drawable/twosidecurveheader"
                     android:padding="24dp">
                     <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="horizontal">

                         <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                             android:text="Course Catalog"
                             android:layout_marginLeft="20dp"
                             android:layout_gravity="center"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:textColor="@color/white"
                             android:textSize="@dimen/big_text"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                     </LinearLayout>





                 </LinearLayout>

                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="match_parent"
                     android:layout_marginTop="110dp"
                     android:padding="20dp"
                     android:orientation="vertical">
                     <LinearLayout
                         android:visibility="gone"
                         android:id="@+id/lnFilter"
                         android:layout_width="match_parent"
                         android:layout_height="50dp"
                         android:background="@drawable/llwhitedesign"
                         android:backgroundTint="@color/white"
                         android:paddingLeft="10dp">
                         <ImageView
                             android:layout_gravity="center"
                             android:layout_width="26dp"
                             android:layout_height="26dp"
                             android:src="@drawable/filter"
                             app:tint="@color/color1"></ImageView>
                         <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:textSize="@dimen/medium_text"
                             android:textColor="@color/color1"
                             android:layout_gravity="center"
                             android:layout_marginLeft="10dp"
                             android:text="Filters"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                     </LinearLayout>
                     <androidx.recyclerview.widget.RecyclerView
                         android:layout_width="match_parent"
                         android:layout_height="match_parent"
                         android:layout_marginTop="20dp"
                         android:id="@+id/rvItem"></androidx.recyclerview.widget.RecyclerView>



                 </LinearLayout>

             </FrameLayout>
         </LinearLayout>




     </LinearLayout>
 </LinearLayout>

</layout>