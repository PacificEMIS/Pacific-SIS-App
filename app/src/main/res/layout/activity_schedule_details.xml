<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.student.activity.ScheduleDetailsActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        >

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:background="@drawable/twosidecurveheader"
                            android:padding="24dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <ImageView
                                    android:id="@+id/imgBack"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/arrow_back_white_48dp"></ImageView>

                                <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                    android:text="My Schedule"
                                    android:layout_marginLeft="20dp"
                                    android:layout_gravity="center"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/big_text"
                                    android:layout_weight="0.5"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>



                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="110dp"
                            android:padding="20dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white"
                                android:padding="10dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    >
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Course"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvCourseTitle"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Course Section"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvCourseSection"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="20dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    >
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Teacher"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvTeacher"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Marking Period"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvMarkingPeriod"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="20dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    >
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Enrolled Date"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvEnrollDate"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="End/Drop Date"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvDropDate"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:visibility="gone"
                                android:id="@+id/lFixedSchedule"
                                android:layout_marginTop="20dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white"
                                android:padding="10dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    >
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/medium_text"
                                            android:textColor="@color/bar"
                                            android:id="@+id/tvScheduleType"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    </LinearLayout>

                                </LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="20dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    >
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Period"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvPeriod"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Room"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvRoom"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="20dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    >
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Time"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvTime"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Take Attendance"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvTakeAttendance"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="20dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/small_text"
                                        android:textColor="@color/bar"
                                        android:text="Meeting Days"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    <LinearLayout
                                        android:layout_marginTop="10dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:id="@+id/lnWeekDays"
                                        android:orientation="horizontal">
                                        <LinearLayout
                                            android:id="@+id/lnSun"
                                            android:gravity="center"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:background="@drawable/llgreystrokedesign">
                                            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                                android:id="@+id/tvSun"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/medium_text"
                                                android:textColor="@color/bar"
                                                android:text="U"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_marginLeft="2dp"
                                            android:id="@+id/lnMon"
                                            android:gravity="center"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:background="@drawable/llgreystrokedesign">
                                            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                                android:id="@+id/tvMon"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/medium_text"
                                                android:textColor="@color/bar"
                                                android:text="M"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_marginLeft="2dp"
                                            android:id="@+id/lnTus"
                                            android:gravity="center"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:background="@drawable/llgreystrokedesign">
                                            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                                android:id="@+id/tvTus"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/medium_text"
                                                android:textColor="@color/bar"
                                                android:text="T"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_marginLeft="2dp"
                                            android:id="@+id/lnWed"
                                            android:gravity="center"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:background="@drawable/llgreystrokedesign">
                                            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                                android:id="@+id/tvWed"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/medium_text"
                                                android:textColor="@color/black"
                                                android:text="W"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_marginLeft="2dp"
                                            android:id="@+id/lnThu"
                                            android:gravity="center"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:background="@drawable/llgreystrokedesign">
                                            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                                android:id="@+id/tvThu"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/medium_text"
                                                android:textColor="@color/bar"
                                                android:text="R"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_marginLeft="2dp"
                                            android:id="@+id/lnFri"
                                            android:gravity="center"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:background="@drawable/llgreystrokedesign">
                                            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                                android:id="@+id/tvFri"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/medium_text"
                                                android:textColor="@color/black"
                                                android:text="F"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_marginLeft="2dp"
                                            android:id="@+id/lnSat"
                                            android:gravity="center"
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:background="@drawable/llgreystrokedesign">
                                            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                                android:id="@+id/tvSat"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/medium_text"
                                                android:textColor="@color/bar"
                                                android:text="S"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/lVariableSchedule"
                                android:layout_marginTop="20dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white"
                                android:padding="10dp">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    >
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/medium_text"
                                            android:textColor="@color/bar"
                                            android:text="Course"
                                            android:id="@+id/tvVariableScheduleType"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    </LinearLayout>

                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:layout_marginTop="10dp">
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="@color/bar"
                                        android:textSize="@dimen/small_text"
                                        android:text="Day"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="@color/bar"
                                        android:textSize="@dimen/small_text"
                                        android:text="Time"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="@color/bar"
                                        android:textSize="@dimen/small_text"
                                        android:text="Period"
                                        android:gravity="center"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="@color/bar"
                                        android:textSize="@dimen/small_text"
                                        android:text="Room"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:textAlignment="center"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:textColor="@color/bar"
                                        android:textSize="@dimen/small_text"
                                        android:text="Take Attendance"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                </LinearLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/bar"></View>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:layout_marginTop="5dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:id="@+id/rvItem"
                                    android:nestedScrollingEnabled="false"></androidx.recyclerview.widget.RecyclerView>

                            </LinearLayout>






                        </LinearLayout>



                    </FrameLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>






        </LinearLayout>
    </LinearLayout>
</layout>