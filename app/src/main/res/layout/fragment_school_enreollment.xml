<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
   >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:background="@drawable/llwhitecurvedesign">

                    <LinearLayout
                        android:layout_marginTop="@dimen/large_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color1"
                            android:textSize="@dimen/big_text"
                            android:text="School and Enrollment Info"
                            android:layout_marginTop="20dp"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/medium_text"
                                android:textColor="@color/bar"
                                android:text="Enrollment Calendar"></com.opensissasstudent.others.customtext.Custom_Text_View>
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_marginTop="2dp"
                                android:id="@+id/tvEnrollMentCalendar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/large_text"
                                android:text="Default Calendar"
                                android:textColor="@color/black"
                                ></com.opensissasstudent.others.customtext.Custom_Text_View>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/medium_text"
                                android:textColor="@color/bar"
                                android:text="Rolling/Retention Option"></com.opensissasstudent.others.customtext.Custom_Text_View>
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_marginTop="2dp"
                                android:id="@+id/tvRolling"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/large_text"
                                android:textColor="@color/black"
                                ></com.opensissasstudent.others.customtext.Custom_Text_View>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/medium_text"
                                android:textColor="@color/bar"
                                android:text="Section"></com.opensissasstudent.others.customtext.Custom_Text_View>
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_marginTop="2dp"
                                android:id="@+id/tvSection"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/large_text"
                                android:textColor="@color/black"
                                ></com.opensissasstudent.others.customtext.Custom_Text_View>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_marginTop="20dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/medium_text"
                                        android:textColor="@color/bar"
                                        android:text="Estimated Graduation Date"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:layout_marginTop="2dp"
                                        android:id="@+id/tvGraduationDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/large_text"
                                        android:textColor="@color/black"
                                        ></com.opensissasstudent.others.customtext.Custom_Text_View>
                                </LinearLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="20dp"
                                    android:background="@color/grey"></View>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="20dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <ImageView
                                            android:id="@+id/imgEligibility"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/check_black_48dp"></ImageView>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:id="@+id/tvEligibility"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/black"
                                            android:layout_marginLeft="10dp"
                                            android:layout_gravity="center"
                                            android:text="504 Eligibility"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_marginTop="10dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <ImageView
                                            android:id="@+id/imgEconomicDisavdantage"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/check_black_48dp"></ImageView>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:id="@+id/tvEconomicDisavdantage"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/black"
                                            android:layout_marginLeft="10dp"
                                            android:layout_gravity="center"
                                            android:text="Economic Disadvantage"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_marginTop="10dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <ImageView
                                            android:id="@+id/imgFreeLunch"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/check_black_48dp"></ImageView>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:id="@+id/tvFreeLunch"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/black"
                                            android:layout_marginLeft="10dp"
                                            android:layout_gravity="center"
                                            android:text="Free Lunch Eligibility"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_marginTop="10dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <ImageView
                                            android:id="@+id/imgEducationIndicator"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/check_black_48dp"></ImageView>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:id="@+id/tvEducationIndicator"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/black"
                                            android:layout_marginLeft="10dp"
                                            android:layout_gravity="center"
                                            android:text="Special Education Indicator"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_marginTop="10dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <ImageView
                                            android:id="@+id/imgLEPIndicator"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:src="@drawable/check_black_48dp"></ImageView>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:id="@+id/tvLEPIndicator"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/black"
                                            android:layout_marginLeft="10dp"
                                            android:layout_gravity="center"
                                            android:text="LEP Indicator"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    </LinearLayout>
                                </LinearLayout>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="20dp"
                                    android:background="@color/grey"></View>
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:visibility="visible"
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:background="@drawable/llwhitecurvedesign">


                    <LinearLayout
                        android:layout_marginTop="@dimen/large_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color1"
                            android:textSize="@dimen/big_text"
                            android:text="Enrollment Information"
                            android:layout_marginTop="20dp"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_marginTop="2dp"
                                android:id="@+id/tvEnrollMentScholl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/large_text"
                                android:textColor="@color/black"
                                ></com.opensissasstudent.others.customtext.Custom_Text_View>
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_marginTop="2dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/medium_text"
                                android:textColor="@color/white"
                                android:text="Home School"
                                android:padding="5dp"
                                android:background="@drawable/llwhitecurvedesign"
                                android:backgroundTint="@color/black"
                                ></com.opensissasstudent.others.customtext.Custom_Text_View>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/medium_text"
                                android:textColor="@color/bar"
                                android:text="Grade Level"></com.opensissasstudent.others.customtext.Custom_Text_View>
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_marginTop="2dp"
                                android:id="@+id/tvGradeLevel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/large_text"
                                android:textColor="@color/black"
                                ></com.opensissasstudent.others.customtext.Custom_Text_View>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/medium_text"
                                android:textColor="@color/bar"
                                android:text="Enrollment Date"></com.opensissasstudent.others.customtext.Custom_Text_View>
                            <com.opensissasstudent.others.customtext.Custom_Text_View
                                android:layout_marginTop="2dp"
                                android:id="@+id/tvDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/large_text"
                                android:textColor="@color/black"
                                ></com.opensissasstudent.others.customtext.Custom_Text_View>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="20dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_marginTop="20dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/medium_text"
                                        android:textColor="@color/bar"
                                        android:text="Enrollment Code"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                    <com.opensissasstudent.others.customtext.Custom_Text_View
                                        android:layout_marginTop="2dp"
                                        android:id="@+id/tvEnrollmentCode"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="@dimen/large_text"
                                        android:textColor="@color/black"
                                        ></com.opensissasstudent.others.customtext.Custom_Text_View>
                                </LinearLayout>


                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llEnrollmentHistory"
                        android:layout_marginTop="@dimen/large_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color1"
                            android:textSize="@dimen/big_text"
                            android:text="Enrollment History"
                            android:layout_marginTop="20dp"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/rvEnrollmentHistory"
                            android:layout_marginTop="10dp"></androidx.recyclerview.widget.RecyclerView>

                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</layout>