<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bar"
            android:textSize="@dimen/small_text"
            android:text="Critical Alert"></com.opensissasstudent.others.customtext.Custom_Text_View>
        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/medium_text"
            android:text="Critical Alert"
            android:layout_marginTop="10dp"
            android:id="@+id/tvCriticalAlert"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>

    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bar"
            android:textSize="@dimen/small_text"
            android:text="Alert Description"></com.opensissasstudent.others.customtext.Custom_Text_View>
        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/medium_text"
            android:text="Critical Alert"
            android:layout_marginTop="10dp"
            android:id="@+id/tvAlertDesc"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>

    </LinearLayout>

</LinearLayout>