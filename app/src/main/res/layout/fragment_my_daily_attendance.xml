<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@drawable/twosidecurveheader"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="20dp"
                                android:layout_weight="0.5"
                                android:text="Daily Attendance"
                                android:textColor="@color/white"
                                android:textSize="@dimen/big_text"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="20dp"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                                android:id="@+id/tvPeriod"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/llwhitecurvedesign"
                                android:paddingLeft="10dp"
                                android:paddingTop="10dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="10dp"
                                android:text="Attendance by Period"
                                android:textColor="@color/text_color"
                                android:textSize="@dimen/medium_text"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>

                            <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                                android:id="@+id/tvDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="20dp"
                                android:background="@drawable/llwhitecurvedesign"
                                android:backgroundTint="@color/text_color"
                                android:paddingLeft="10dp"
                                android:paddingTop="10dp"
                                android:paddingRight="10dp"
                                android:paddingBottom="10dp"
                                android:text="Attendance by Day"
                                android:textColor="@color/white"
                                android:textSize="@dimen/medium_text"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>

                        </LinearLayout>


                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="110dp">

                        <LinearLayout
                            android:id="@+id/llPeriod"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white"
                                android:orientation="vertical"
                                android:padding="10dp"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                                        android:layout_width="100dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="Date"
                                        android:textSize="@dimen/small_text"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>

                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/rvPeriod"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginTop="10dp"></androidx.recyclerview.widget.RecyclerView>
                                </LinearLayout>

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rvStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"></androidx.recyclerview.widget.RecyclerView>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="10dp"
                                android:background="@drawable/llgreystrokedesign"
                                android:backgroundTint="@color/white">
                                <org.naishadhparmar.zcustomcalendar.CustomCalendar
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:id="@+id/custom_calendar"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"/>
                            </LinearLayout>


                        </LinearLayout>


                    </FrameLayout>


                </FrameLayout>
            </LinearLayout>


        </LinearLayout>
    </LinearLayout>

</layout>