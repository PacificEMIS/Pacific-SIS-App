<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/llwhitedesign"
    android:backgroundTint="@color/white"
    android:padding="10dp"
    android:layout_marginBottom="20dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        >
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_weight="0.48"
            android:background="@drawable/oval"
            android:backgroundTint="@color/totalpercentage"
            android:gravity="center"
            android:padding="5dp">
            <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/medium_text"
                android:id="@+id/tvLetter"
                android:textColor="@color/black"
                android:textAlignment="center"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">
            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/large_text"
                android:textColor="@color/black"
                android:id="@+id/tvCourseName"
                ></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/bar"
                android:id="@+id/tvPercentage"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:gravity="end">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgTeacher"
            android:layout_gravity="center"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/student_user"></de.hdodenhof.circleimageview.CircleImageView>
        <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/medium_text"
            android:textColor="@color/black"
            android:id="@+id/tvStaff"
            android:layout_gravity="center"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
    </LinearLayout>

</LinearLayout>