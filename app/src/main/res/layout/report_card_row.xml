<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/llwhitedesign"
    android:backgroundTint="@color/white"
   android:layout_marginBottom="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.pacific.others.customtext.Custom_Text_View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bar"
                        android:textSize="@dimen/small_text"
                        android:text="Course"></com.pacific.others.customtext.Custom_Text_View>
                    <com.pacific.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/medium_text"
                        android:id="@+id/tvCourse"></com.pacific.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.pacific.others.customtext.Custom_Text_View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/bar"
                        android:textSize="@dimen/small_text"
                        android:text="Teacher"></com.pacific.others.customtext.Custom_Text_View>
                    <com.pacific.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/medium_text"
                        android:id="@+id/tvTeacher"></com.pacific.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>
            </LinearLayout>


        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacific.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bar"
                    android:textSize="@dimen/small_text"
                    android:text="Grade"></com.pacific.others.customtext.Custom_Text_View>
                <com.pacific.others.customtext.Custom_Text_View_SemiBold
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/medium_text"
                    android:id="@+id/tvGrade"></com.pacific.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacific.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bar"
                    android:textSize="@dimen/small_text"
                    android:text="GPA"></com.pacific.others.customtext.Custom_Text_View>
                <com.pacific.others.customtext.Custom_Text_View_SemiBold
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/medium_text"
                    android:id="@+id/tvGPA"></com.pacific.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llComment"
        android:background="@color/grey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/commentary"
                app:tint="@color/text_color"></ImageView>
            <com.pacific.others.customtext.Custom_Text_View_SemiBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/medium_text"
                android:layout_marginLeft="10dp"
                android:textColor="@color/text_color"
                android:text="Comments"></com.pacific.others.customtext.Custom_Text_View_SemiBold>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/llCommentDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey"
            ></View>
        <LinearLayout
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/commentary"
                    app:tint="@color/text_color"></ImageView>
                <com.pacific.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/text_color"
                    android:text="Comments"></com.pacific.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>
            <com.pacific.others.customtext.Custom_Text_View_SemiBold
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/large_text"
                android:layout_marginLeft="40dp"
                android:textColor="@color/black"
                android:id="@+id/tvComments"></com.pacific.others.customtext.Custom_Text_View_SemiBold>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey"
           ></View>
        <LinearLayout
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/commentary"
                    app:tint="@color/text_color"></ImageView>
                <com.pacific.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/text_color"
                    android:text="Teacher Comments"></com.pacific.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>
            <com.pacific.others.customtext.Custom_Text_View_SemiBold
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/large_text"
                android:layout_marginLeft="40dp"
                android:textColor="@color/black"
                android:id="@+id/tvTeacherComments"></com.pacific.others.customtext.Custom_Text_View_SemiBold>
        </LinearLayout>
    </LinearLayout>



</LinearLayout>