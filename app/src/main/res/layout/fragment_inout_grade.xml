<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".ui.teacher.fragment.InputGradeFragment"
    android:padding="10dp">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
            android:textColor="@color/white"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/llwhitedesign"
            android:backgroundTint="@color/text_color"
            android:layout_marginRight="10dp"
            android:textSize="14sp"
            android:text="Get Gradebook \nGrades"
            android:id="@+id/btnGetGradeBook"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
        <LinearLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="@drawable/llgreystrokedesign">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/spMarkingPeriod"></Spinner>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="0dp"
                    android:layout_weight="0.5"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:text="Student Details"
                    android:layout_gravity="center"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                <LinearLayout
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="10dp">
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:text="Percent"
                        android:layout_gravity="center"
                        android:textColor="@color/black"
                        android:visibility="gone"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.suke.widget.SwitchButton
                        android:layout_marginLeft="5dp"
                        android:id="@+id/switch_button"
                        app:sb_checked="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"></com.suke.widget.SwitchButton>

                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rvItem"
                android:nestedScrollingEnabled="false"></androidx.recyclerview.widget.RecyclerView>
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/lnComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">
                <com.opensissasstudent.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:text="Teacher Comments"></com.opensissasstudent.others.customtext.Custom_Text_View>
                <EditText
                    android:textSize="@dimen/small_text"
                    android:id="@+id/etComments"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/llgreystrokedesign"
                    android:gravity="top"
                    android:padding="5dp"
                    android:textColor="@color/text_color"
                    ></EditText>
                <LinearLayout
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.3"
                    android:gravity="center|right">
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:background="@drawable/llgreystrokedesign"
                        android:backgroundTint="@color/text_color"
                        android:text="Submit"
                        android:id="@+id/tvSubmit"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:textSize="@dimen/big_text"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>




</LinearLayout>