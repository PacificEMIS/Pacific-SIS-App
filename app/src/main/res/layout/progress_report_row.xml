<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_marginBottom="20dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/llProgressReport"
        android:padding="10dp"
        android:weightSum="3.2"
        >
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Course"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>
            <com.pacificstudentteacher.others.customtext.Custom_Text_View
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
               android:id="@+id/tvCourse"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Course Section"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>
            <com.pacificstudentteacher.others.customtext.Custom_Text_View
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:id="@+id/tvCourseSection"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:text="Teacher"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>
            <com.pacificstudentteacher.others.customtext.Custom_Text_View
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/small_text"
                android:textColor="@color/text_color"
                android:id="@+id/tvTeacher"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"
            android:gravity="center">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imgDown"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_baseline_arrow_drop_down_24"></ImageView>
                <ImageView
                    android:visibility="gone"
                    android:id="@+id/imgUp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_baseline_arrow_drop_up_24"></ImageView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/llProgressReportDetails"
        android:orientation="vertical">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/rvProgressReport"></androidx.recyclerview.widget.RecyclerView>
        <LinearLayout
            android:id="@+id/llTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@color/grey">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:orientation="horizontal">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/text_color"
                    android:text="Total Points"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/text_color"
                    android:id="@+id/tvPoints"
                    android:layout_gravity="center"
                    android:layout_marginLeft="2dp"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="horizontal">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/text_color"
                    android:text="Total Grade"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_marginLeft="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/text_color"
                    android:id="@+id/tvTotalGrade"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/text_color"
                    android:text="Total Weight Grade"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_marginLeft="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/text_color"
                    android:id="@+id/tvWeightGrade"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>