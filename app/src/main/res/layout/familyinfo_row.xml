<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgProfile"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:src="@drawable/student_user"
            android:layout_weight="0.3"></de.hdodenhof.circleimageview.CircleImageView>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/large_text"
                android:textColor="@color/black"
                android:id="@+id/tvName"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:weightSum="2">
                <com.opensissasstudent.others.customtext.Custom_Text_View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bar"
                    android:textSize="@dimen/small_text"
                    android:id="@+id/tvRealation"
                    android:layout_weight="0.5"></com.opensissasstudent.others.customtext.Custom_Text_View>
                <com.opensissasstudent.others.customtext.Custom_Text_View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bar"
                    android:textSize="@dimen/small_text"
                    android:id="@+id/tvCustody"
                    android:text="Custody"
                    android:layout_weight="0.5"
                    android:visibility="gone"></com.opensissasstudent.others.customtext.Custom_Text_View>
                <com.opensissasstudent.others.customtext.Custom_Text_View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:textSize="@dimen/small_text"
                    android:background="@drawable/llwhitecurvedesign"
                    android:padding="3dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tvContactType"></com.opensissasstudent.others.customtext.Custom_Text_View>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"></View>

</LinearLayout>