<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginRight="5dp"
    android:background="@drawable/llgreystrokedesign"
    android:backgroundTint="@color/white">
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="80dp"
        android:padding="10dp"
        android:orientation="horizontal">
        <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_color"
            android:textSize="@dimen/large_text"
            android:id="@+id/tvCourse"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="0.5"
            android:backgroundTint="@color/color2"
            android:background="@drawable/llgreystrokedesign"
            android:gravity="center"
            android:id="@+id/tvStatus"
            android:textColor="@color/white"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>


    </LinearLayout>

</LinearLayout>