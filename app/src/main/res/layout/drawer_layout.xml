<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:id="@+id/lnBlank">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4"
        android:background="@mipmap/wave"
        android:gravity="center">
        <LinearLayout
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                >
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/imgUser"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/profile"
                    ></de.hdodenhof.circleimageview.CircleImageView>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:tint="@color/white"
                    android:id="@+id/fabCamera"
                    android:layout_gravity="bottom|right"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/camera"
                    android:visibility="gone"/>


            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_gravity="center"
                android:orientation="vertical">
                <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                    android:id="@+id/tvTeacherName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/big_text"
                    android:textColor="@color/black"
                    android:text="Arpan Saha"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/llwhitestrokedesign"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:textSize="@dimen/medium_text"
                    android:text="Teacher"
                    android:id="@+id/tvMemberShip"
                    android:layout_marginTop="14dp"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/llsDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/home_grey"
                        ></ImageView>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:layout_gravity="center"
                        android:layout_marginLeft="20dp"
                        android:text="Home"
                        android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:id="@+id/llsSchool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/school_grey"
                        ></ImageView>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:layout_gravity="center"
                        android:layout_marginLeft="20dp"
                        android:text="School"
                        android:textColor="@color/black"
                        android:layout_weight="1"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/imgUpArrow"
                            android:visibility="gone"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_baseline_arrow_drop_up_24"
                            app:tint="@color/grey"></ImageView>
                        <ImageView
                            android:id="@+id/imgDownArrow"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_baseline_arrow_drop_down_24"
                            app:tint="@color/grey"></ImageView>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    android:id="@+id/llChildSchool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="50dp">

                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvSchoolInformation"
                        android:text="School Information"
                        android:textColor="@color/black"
                        android:layout_marginTop="10dp"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvMarkingPeriod"
                        android:text="Marking Periods"
                        android:textColor="@color/black"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvCalendar"
                        android:text="Calendars"
                        android:textColor="@color/black"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvNotice"
                        android:text="Notices"
                        android:textColor="@color/black"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvMentalHealth"
                        android:text="Mental Health Info"
                        android:textColor="@color/black"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:id="@+id/llMyInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/profileuser"
                        ></ImageView>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:layout_gravity="center"
                        android:layout_marginLeft="20dp"
                        android:text="My Info"
                        android:id="@+id/tvInfo"
                        android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:id="@+id/llsCourse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/classes_grey"
                        ></ImageView>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:layout_gravity="center"
                        android:layout_marginLeft="20dp"
                        android:text="Course Catalog"
                        android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:id="@+id/llsSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/schedules_grey"
                        ></ImageView>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:layout_gravity="center"
                        android:layout_marginLeft="20dp"
                        android:text="My Schedule"
                        android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:id="@+id/llAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/alarmclock"
                        ></ImageView>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:layout_gravity="center"
                        android:layout_marginLeft="20dp"
                        android:text="Attendance"
                        android:textColor="@color/black"
                        android:layout_weight="1"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:visibility="gone"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_baseline_arrow_drop_up_24"
                            app:tint="@color/grey"></ImageView>
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_baseline_arrow_drop_down_24"
                            app:tint="@color/grey"></ImageView>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    android:id="@+id/llChildAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="50dp">

                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvAbsentSummary"
                        android:text="Absent Summary"
                        android:textColor="@color/black"
                        android:layout_marginTop="10dp"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvAttendance"
                        android:text="Daily Attendance"
                        android:textColor="@color/black"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>

                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:id="@+id/llsGrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/reports_grey"
                        ></ImageView>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:layout_gravity="center"
                        android:layout_marginLeft="20dp"
                        android:text="Grades"
                        android:textColor="@color/black"
                        android:layout_weight="1"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/imgGradesUpArrow"
                            android:visibility="gone"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_baseline_arrow_drop_up_24"
                            app:tint="@color/grey"></ImageView>
                        <ImageView
                            android:id="@+id/imgGradesDownArrow"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_baseline_arrow_drop_down_24"
                            app:tint="@color/grey"></ImageView>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    android:id="@+id/llGradeChild"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="50dp">

                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvGradeBook"
                        android:text="Gradebook Grades"
                        android:textColor="@color/black"
                        android:layout_marginTop="14dp"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvProgressReport"
                        android:text="Progress Report"
                        android:textColor="@color/black"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvReportCards"
                        android:text="Report Cards"
                        android:textColor="@color/black"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvTranscripts"
                        android:text="Transcripts"
                        android:textColor="@color/black"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                    <com.opensissasstudent.others.customtext.Custom_Text_View
                        android:visibility="gone"
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:id="@+id/tvHonorRoll"
                        android:text="Honor Roll"
                        android:textColor="@color/black"
                        ></com.opensissasstudent.others.customtext.Custom_Text_View>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:id="@+id/llsChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/key"
                        ></ImageView>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:layout_gravity="center"
                        android:layout_marginLeft="20dp"
                        android:text="Change Password"
                        android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:id="@+id/llsLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/logout_grey"
                        ></ImageView>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/large_text"
                        android:layout_gravity="center"
                        android:layout_marginLeft="20dp"
                        android:text="Logout"
                        android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.14"></LinearLayout>

</LinearLayout>