<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.common.activity.ChangePasswordActivity">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@drawable/twosidecurveheader"
                        android:padding="24dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <ImageView
                                android:id="@+id/imgBack"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:src="@drawable/arrow_back_white_48dp"></ImageView>
                            <com.pacific.others.customtext.Custom_Text_View_Bold
                                android:id="@+id/tvCourseName"
                                android:layout_marginLeft="20dp"
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Change Password"
                                android:textColor="@color/white"
                                android:textSize="@dimen/big_text"></com.pacific.others.customtext.Custom_Text_View_Bold>
                        </LinearLayout>





                    </LinearLayout>

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="110dp"
                        android:padding="20dp"
                        android:id="@+id/lnFragment"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:backgroundTint="@color/background_color"
                            android:background="@drawable/llwhitedesign">
                            <com.pacific.others.customtext.Custom_Text_View
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textColor="@color/color7"
                                android:text="Current Password"
                                android:id="@+id/tvCurrentPassword"></com.pacific.others.customtext.Custom_Text_View>
                            <com.pacific.others.customtext.Custom_EditText
                                android:layout_marginTop="10dp"
                                android:textColor="@color/color7"
                                android:padding="5dp"
                                android:textSize="16sp"
                                android:id="@+id/etCurrentPassword"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white"
                                android:inputType="textPassword"></com.pacific.others.customtext.Custom_EditText>

                            <com.pacific.others.customtext.Custom_Text_View
                                android:layout_marginTop="20dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textColor="@color/color7"
                                android:text="New Password"
                                android:id="@+id/tvNewPassword"></com.pacific.others.customtext.Custom_Text_View>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white">
                                <com.pacific.others.customtext.Custom_EditText
                                    android:textColor="@color/color7"
                                    android:padding="5dp"
                                    android:textSize="16sp"
                                    android:id="@+id/etNewPassword"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:background="@null"
                                    android:inputType="textPassword"
                                    android:layout_weight="1"></com.pacific.others.customtext.Custom_EditText>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="0.1"
                                    android:gravity="center">

                                    <ImageView
                                        android:id="@+id/imgClose"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/eyeclose"
                                        app:tint="@color/grey"></ImageView>

                                    <ImageView
                                        android:id="@+id/imgOpen"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:src="@drawable/eye"
                                        android:visibility="gone"
                                        app:tint="@color/grey"></ImageView>
                                </LinearLayout>

                            </LinearLayout>


                            <LinearLayout
                                android:layout_marginTop="5dp"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:orientation="vertical">
                                <com.pacific.others.customtext.Custom_Text_View
                                    android:layout_marginTop="5dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="16sp"
                                    android:textColor="@color/color7"
                                    android:text="Auto Generate Password"
                                    android:id="@+id/tvAutoPassword"
                                    ></com.pacific.others.customtext.Custom_Text_View>
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/color7"></View>
                            </LinearLayout>
                            <com.pacific.others.customtext.Custom_Text_View
                                android:layout_marginTop="20dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textColor="@color/color7"
                                android:text="Confirm New Password"
                                android:id="@+id/tvConNewPassword"></com.pacific.others.customtext.Custom_Text_View>
                            <com.pacific.others.customtext.Custom_EditText
                                android:layout_marginTop="10dp"
                                android:textColor="@color/color7"
                                android:padding="5dp"
                                android:textSize="16sp"
                                android:id="@+id/etConNewPassword"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white"
                                android:inputType="textPassword"></com.pacific.others.customtext.Custom_EditText>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:gravity="right">
                                <com.pacific.others.customtext.Custom_Text_View_Bold
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="16sp"
                                    android:textColor="@color/white"
                                    android:paddingLeft="14dp"
                                    android:paddingRight="14sp"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="10dp"
                                    android:text="Update"
                                    android:background="@drawable/llwhitedesign"
                                    android:backgroundTint="@color/color7"
                                    android:id="@+id/tvUpdate"></com.pacific.others.customtext.Custom_Text_View_Bold>
                            </LinearLayout>

                        </LinearLayout>



                    </LinearLayout>

                </FrameLayout>
            </LinearLayout>




        </LinearLayout>
    </LinearLayout>
</layout>
