<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical">
    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/white">
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:textAlignment="center"
            android:textColor="@color/black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/tvCourseCode"
            android:layout_gravity="center"
            android:textSize="@dimen/small_text"></com.opensissasstudent.others.customtext.Custom_Text_View>
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:textColor="@color/black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/tvCourse"
            android:layout_gravity="center"
            android:textSize="@dimen/small_text"></com.opensissasstudent.others.customtext.Custom_Text_View>
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:textAlignment="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:id="@+id/tvCredtHours"
            android:layout_gravity="center"
            android:textSize="@dimen/small_text"
            android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View>
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:textAlignment="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:id="@+id/tvCreditEarned"
            android:layout_gravity="center"
            android:textSize="@dimen/small_text"
            android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View>
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:textAlignment="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:id="@+id/tvGrade"
            android:layout_gravity="center"
            android:textSize="@dimen/small_text"
            android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View>
        <com.opensissasstudent.others.customtext.Custom_Text_View
            android:textAlignment="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:id="@+id/tvGP"
            android:layout_gravity="center"
            android:textSize="@dimen/small_text"
            android:textColor="@color/black"></com.opensissasstudent.others.customtext.Custom_Text_View>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bar"></View>



</LinearLayout>