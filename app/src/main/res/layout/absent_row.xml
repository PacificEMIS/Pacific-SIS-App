<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">
    <LinearLayout
        android:id="@+id/llAbsent"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:layout_gravity="center">
            <LinearLayout
                android:id="@+id/llShortCode"
                android:gravity="center"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/oval"
                android:backgroundTint="@color/text_color">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/white"
                    android:id="@+id/tvAttendanceShortCode"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/large_text"
                android:textColor="@color/black"
                android:id="@+id/tvAttendanceCode"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            <com.pacificstudentteacher.others.customtext.Custom_Text_View
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/medium_text"
                android:textColor="@color/grey"
                android:id="@+id/tvDate"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"
            android:gravity="center">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imgDown"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_baseline_arrow_drop_down_24"></ImageView>
                <ImageView
                    android:visibility="gone"
                    android:id="@+id/imgUp"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_baseline_arrow_drop_up_24"></ImageView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/llAbsentDetails"
        android:orientation="vertical">
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center">
            <com.pacificstudentteacher.others.customtext.Custom_Text_View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/medium_text"
                android:textColor="@color/text_color"
                android:id="@+id/tvPeriod"
                android:gravity="center"
                android:text="Period"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/black"></View>
            <com.pacificstudentteacher.others.customtext.Custom_Text_View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/medium_text"
                android:textColor="@color/text_color"
                android:text="Status"
                android:gravity="center"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bar"></View>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/rvChild"></androidx.recyclerview.widget.RecyclerView>
        <LinearLayout
            android:id="@+id/llComment"
            android:visibility="visible"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/grey"
            android:padding="10dp">
            <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/medium_text"
                android:textColor="@color/text_color"
                android:id="@+id/tvAdminComment"
                android:layout_gravity="center"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>

            <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/medium_text"
                android:textColor="@color/text_color"
                android:id="@+id/tvTeacherComment"
                android:layout_gravity="center"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>