<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/llwhitedesign"
    android:backgroundTint="@color/white"
    android:padding="10dp"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">
    <LinearLayout
        android:id="@+id/llAssignment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/large_text"
                android:textColor="@color/black"
                android:id="@+id/tvAssignmentName"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            <LinearLayout
                android:id="@+id/llTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvTitlePoints"
                    android:layout_gravity="center"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <View
                    android:layout_gravity="center"
                    android:layout_marginLeft="20dp"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@color/bar"
                    android:layout_marginRight="20dp"></View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvTitlePercentage"
                    android:layout_gravity="center"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <View
                    android:layout_gravity="center"
                    android:layout_marginLeft="20dp"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@color/bar"
                    android:layout_marginRight="20dp"></View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvTitleLetter"
                    android:layout_gravity="center"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.1"
            android:gravity="center">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imgDown"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_baseline_arrow_drop_down_24"></ImageView>
                <ImageView
                    android:visibility="gone"
                    android:id="@+id/imgUp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_baseline_arrow_drop_up_24"></ImageView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:visibility="gone"
        android:id="@+id/llAssignDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
           >
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/bar"
                    android:text="Assignment Type"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvAssignmentType"
                    android:layout_marginTop="5dp"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/bar"
                    android:text="Ponts/Possibles"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvPointsPossibles"
                    android:layout_marginTop="5dp"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/bar"
                    android:text="Percent"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvPercent"
                    android:layout_marginTop="5dp"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/bar"
                    android:text="Letter"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvLetter"
                    android:layout_marginTop="5dp"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/bar"
                    android:text="Assigned Date"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvAssignedDate"
                    android:layout_marginTop="5dp"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/bar"
                    android:text="Due Date"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvDueDate"
                    android:layout_marginTop="5dp"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/bar"
                    android:text="Grade Range"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvGradeRange"
                    android:layout_marginTop="5dp"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>



        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/small_text"
                    android:textColor="@color/bar"
                    android:text="Assignment Description"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                <com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/medium_text"
                    android:textColor="@color/black"
                    android:id="@+id/tvAssignementDesc"
                    android:layout_marginTop="5dp"></com.pacificstudentteacher.others.customtext.Custom_Text_View_SemiBold>
            </LinearLayout>



        </LinearLayout>
    </LinearLayout>

</LinearLayout>