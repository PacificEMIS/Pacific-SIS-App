<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@drawable/twosidecurveheader"
                        android:padding="24dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/arrow_back_white_48dp"
                                android:id="@+id/imgBack"></ImageView>

                            <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                                android:text="Transcript"
                                android:layout_marginLeft="20dp"
                                android:layout_gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/big_text"
                                android:layout_weight="0.5"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>



                        </LinearLayout>






                    </LinearLayout>

                        <LinearLayout
                            android:visibility="visible"
                            android:id="@+id/llList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="20dp"
                            android:orientation="vertical"
                            android:layout_marginTop="110dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white"
                                android:padding="10dp"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <de.hdodenhof.circleimageview.CircleImageView
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:id="@+id/imgSchlImage"></de.hdodenhof.circleimageview.CircleImageView>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_marginLeft="10dp"
                                        android:orientation="vertical">
                                        <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/black"
                                            android:textSize="@dimen/big_text"
                                            android:id="@+id/tvSchlName"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>
                                        <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/bar"
                                            android:textSize="@dimen/small_text"
                                            android:id="@+id/tvSchlAddress"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_marginTop="20dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="0.5"
                                        android:orientation="vertical">
                                        <com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/large_text"
                                            android:id="@+id/tvStudentName"
                                            android:textColor="@color/black"></com.pacificstudentteacher.others.customtext.Custom_Text_View_Bold>
                                        <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:id="@+id/tvStudentAddress"
                                            android:textColor="@color/bar"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                        <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:id="@+id/tvStudentDOB"
                                            android:textColor="@color/bar"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                        <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                            android:layout_marginTop="5dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:id="@+id/tvStudentID"
                                            android:textColor="@color/bar"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.7"
                                        android:background="@drawable/llgreystrokedesign">
                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:weightSum="3"
                                            android:orientation="vertical"
                                            android:layout_marginRight="5dp">
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="0dp"
                                                android:layout_weight="1"
                                                android:gravity="center|right">
                                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textSize="@dimen/small_text"
                                                    android:textColor="@color/black"
                                                    android:text="Cumulative GPA"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                            </LinearLayout>
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="0dp"
                                                android:layout_weight="1"
                                                android:gravity="center|right">
                                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textSize="@dimen/small_text"
                                                    android:textColor="@color/black"
                                                    android:text="Total Credit Attempted"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                            </LinearLayout>
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="0dp"
                                                android:layout_weight="1"
                                                android:gravity="center|right">
                                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textSize="@dimen/small_text"
                                                    android:textColor="@color/black"
                                                    android:text="Total Credit Earned"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                            </LinearLayout>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_weight="0.3"
                                            android:weightSum="3"
                                            android:orientation="vertical"
                                            android:background="@color/black"
                                           >
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="0dp"
                                                android:layout_weight="1"
                                                android:gravity="center|right">
                                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textSize="@dimen/small_text"
                                                    android:textColor="@color/white"
                                                    android:id="@+id/tvCumulativeGPA"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                            </LinearLayout>
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="0dp"
                                                android:layout_weight="1"
                                                android:gravity="center|right">
                                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textSize="@dimen/small_text"
                                                    android:textColor="@color/white"
                                                    android:id="@+id/tvCreditAttemted"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                            </LinearLayout>
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="0dp"
                                                android:layout_weight="1"
                                                android:gravity="center|right">
                                                <com.pacificstudentteacher.others.customtext.Custom_Text_View
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:textSize="@dimen/small_text"
                                                    android:textColor="@color/white"
                                                    android:id="@+id/tvCreditEarned"></com.pacificstudentteacher.others.customtext.Custom_Text_View>
                                            </LinearLayout>
                                        </LinearLayout>

                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <androidx.recyclerview.widget.RecyclerView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="20dp"
                                android:id="@+id/rvItem"></androidx.recyclerview.widget.RecyclerView>





                        </LinearLayout>





                </FrameLayout>
            </LinearLayout>




        </LinearLayout>
    </LinearLayout>
</layout>