<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@drawable/twosidecurveheader"
                        android:padding="24dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <ImageView
                                android:id="@+id/imgBack"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/arrow_back_white_48dp"></ImageView>

                            <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                android:text="Gradebook Grades"
                                android:layout_marginLeft="20dp"
                                android:layout_gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/big_text"
                                android:layout_weight="0.5"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>



                        </LinearLayout>






                    </LinearLayout>
                    <FrameLayout
                        android:layout_marginTop="110dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:visibility="visible"
                            android:id="@+id/llList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="20dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/llwhitedesign"
                                android:backgroundTint="@color/white"
                                android:padding="10dp"
                                android:orientation="vertical"
                                >
                                <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/large_text"
                                    android:textColor="@color/color1"
                                    android:id="@+id/tvCourseName"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Teacher"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/medium_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvTeacher"
                                            android:layout_marginTop="5dp"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Percent"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/medium_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvPercent"
                                            android:layout_marginTop="5dp"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>

                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Letter"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/medium_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvLetter"
                                            android:layout_marginTop="5dp"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Ungraded"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/medium_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvUngraded"
                                            android:layout_marginTop="5dp"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>

                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp">
                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">
                                        <com.opensissasstudent.others.customtext.Custom_Text_View
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/small_text"
                                            android:textColor="@color/bar"
                                            android:text="Grade Range"></com.opensissasstudent.others.customtext.Custom_Text_View>
                                        <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="@dimen/medium_text"
                                            android:textColor="@color/black"
                                            android:id="@+id/tvGradeRange"
                                            android:layout_marginTop="5dp"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>
                                    </LinearLayout>


                                </LinearLayout>
                            </LinearLayout>


                            <androidx.recyclerview.widget.RecyclerView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="20dp"
                                android:id="@+id/rvItem"></androidx.recyclerview.widget.RecyclerView>



                        </LinearLayout>

                    </FrameLayout>




                </FrameLayout>
            </LinearLayout>




        </LinearLayout>
    </LinearLayout>
</layout>