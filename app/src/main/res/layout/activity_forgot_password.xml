<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@mipmap/login_bg"
    tools:context=".ui.common.activity.ForgotPasswordActivity">
    <LinearLayout
        android:id="@+id/lnLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_gravity="center"
                    android:id="@+id/lnLogo"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:background="@mipmap/login_logo"
                    android:gravity="center"
                    android:visibility="visible">

                    <ImageView
                        android:src="@mipmap/pacific_sis_logo"
                        android:id="@+id/imgLogo"
                        android:layout_width="60dp"
                        android:layout_height="60dp"></ImageView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/llwhitedesign"
                    android:backgroundTint="@color/orangecolor"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                        android:id="@+id/tvSchool"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="@dimen/large_text" />

                </LinearLayout>
                <LinearLayout
                    android:visibility="visible"
                    android:id="@+id/llForgotSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">
                        <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/big_text"
                            android:textColor="@color/white"
                            android:text="Forgot Password?"
                            android:layout_gravity="center"
                            ></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                        <com.opensissasstudent.others.customtext.Custom_Text_View
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/small_text"
                            android:textColor="@color/white"
                            android:text="No worries, enter your registered email below to receive password reset instructions"
                            android:layout_gravity="center"
                            android:textAlignment="center"
                            android:layout_marginTop="5dp"></com.opensissasstudent.others.customtext.Custom_Text_View>


                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_marginTop="10dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/llwhitestrokedesign">

                            <EditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:backgroundTint="@color/trasparent"
                                android:hint="Email Address"
                                android:inputType="textEmailAddress"
                                android:textColor="@color/white"
                                android:textSize="@dimen/large_text" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>


                    <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                        android:id="@+id/tvSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/llwhitestrokedesign"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="Submit"
                        android:textColor="@color/black"
                        android:textSize="@dimen/large_text"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llSucess"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center">
                        <LinearLayout
                            android:backgroundTint="@color/white"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:background="@drawable/oval"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/email"></ImageView>
                        </LinearLayout>
                    </LinearLayout>
                    <com.opensissasstudent.others.customtext.Custom_Text_View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/small_text"
                        android:text="We sent you an email to reset your password.

Please check all inboxes including spam and junk folders as automated emails often get filtered there period"
                        android:textColor="@color/white"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"></com.opensissasstudent.others.customtext.Custom_Text_View>
                    <com.opensissasstudent.others.customtext.Custom_Text_View_Bold
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="@dimen/medium_text"
                        android:textColor="@color/white"
                        android:textAlignment="center"
                        android:layout_marginTop="20dp"
                        android:text="Did not receive any mail? Resend email"
                        android:layout_gravity="center"
                        android:id="@+id/tvResendMail"></com.opensissasstudent.others.customtext.Custom_Text_View_Bold>
                </LinearLayout>
                <com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/large_text"
                    android:text="Remember your password? Login"
                    android:id="@+id/tvLogin"></com.opensissasstudent.others.customtext.Custom_Text_View_SemiBold>


            </LinearLayout>
        </ScrollView>


    </LinearLayout>
</LinearLayout>